    - target: {fileID: 4319386666851946622, guid: a54026f9a7b54d94ba65cd06c1bdae06, type: 3}
      propertyPath: m_Name
      value: FIELD LOG 1997-07-16T19:20+01:00
      objectReference: {fileID: 0}
    - target: {fileID: 7557560697182627970, guid: a54026f9a7b54d94ba65cd06c1bdae06, type: 3}
      propertyPath: m_PresetInfoIsWorld
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 9095966450029517478, guid: a54026f9a7b54d94ba65cd06c1bdae06, type: 3}
      propertyPath: interactionVerb
      value: TAKE
      objectReference: {fileID: 0}
    - target: {fileID: 9095966450029517478, guid: a54026f9a7b54d94ba65cd06c1bdae06, type: 3}
      propertyPath: shortDescription
      value: "Y'know, I'm not scared of many things. I've climbed Everest, dove in
        the Great Trench (unassisted), and I've even socked my armed, 6 foot tall
        mother right in the nose. \n\nBut THIS? Y'ALL KNOW humans fear the dark.
        IT'S A BIOLOGICAL, EVOLUTIONARY, BUILT-INNNN SURVIVAL MECHANISM, but nah, 
        y'all keep saying \"It's not reeaaal\" - do you know HOW MANY TIMES on my
        form I EXPLICITLY noted: \"Please sirs, anywhere but the dark.\" AND THEN
        YOU SEND ME HERE??? HAHAHAHAHAHAHAHAHAHAHAHAHAH HERE'S YOOUR FUCKING REPORT:\n\n[Unauthorized
        Access]\n"
      objectReference: {fileID: 0}
    - target: {fileID: 9095966450029517478, guid: a54026f9a7b54d94ba65cd06c1bdae06, type: 3}
      propertyPath: interactSound.Path
      value: event:/pickup object
